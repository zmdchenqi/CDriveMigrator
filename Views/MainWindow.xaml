<Window x:Class="CDriveMigrator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CDriveMigrator.Converters"
        xmlns:vm="clr-namespace:CDriveMigrator.ViewModels"
        Title="CDriveMigrator — C盘软件智能迁移工具 | 抖音: 大刀AI很大刀"
        Height="800" Width="1280" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <conv:RiskLevelToColorConverter x:Key="RiskColorConv"/>
        <conv:MigrationStatusToColorConverter x:Key="StatusColorConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:ReferenceTypeToIconConverter x:Key="RefIconConv"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:RecommendationToColorConverter x:Key="RecColorConv"/>
        <conv:ProgressToWidthConverter x:Key="ProgressToWidth"/>

        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        </Style>

        <!-- Button style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F5C"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#374151"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- ComboBox ToggleButton template (dark themed) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#2D2D44"
                        BorderBrush="#4B5563" BorderThickness="1" CornerRadius="4"/>
                <Path x:Name="Arrow" Grid.Column="1" Fill="#9CA3AF"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 L4,4 8,0"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#363654"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#7C3AED"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Full dark ComboBox template -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,4,24,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown" Background="#2D2D44"
                                        BorderBrush="#4B5563" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem dark style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C1D95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B3B5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="#E2E8F0"/>
        </Style>

        <!-- CheckBox style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#4F46E5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CDriveMigrator" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="C盘软件智能迁移工具 — 扫描 → 分析 → 迁移 → 自动修复全部配置" 
                               FontSize="12" Foreground="#D1D5DB" Margin="0,4,0,0"/>
                    <TextBlock FontSize="11" Foreground="#A78BFA" Margin="0,2,0,0">
                        <Run Text="❤ 抖音关注: "/><Run Text="大刀AI很大刀" FontWeight="Bold" Foreground="#C084FC"/>
                        <Run Text=" | 免费工具 禁止倒卖" Foreground="#EF4444"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="发现" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalPrograms}" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="个程序" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="4,0,16,0"/>
                        <TextBlock Text="总占用" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalSizeDisplay}" FontWeight="Bold" FontSize="18" Foreground="#FDE047" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Border Background="#166534" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="建议迁移 " Foreground="#86EFAC" FontSize="11"/>
                                <TextBlock Text="{Binding SafeCount}" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#78350F" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="需分析 " Foreground="#FDE68A" FontSize="11"/>
                                <TextBlock Text="{Binding CautionCount}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#7F1D1D" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="不建议 " Foreground="#FCA5A5" FontSize="11"/>
                                <TextBlock Text="{Binding NotRecommendedCount}" Foreground="#EF4444" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Program List -->
            <Border Grid.Column="0" Background="#2D2D44" CornerRadius="8" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List header -->
                    <Border Grid.Row="0" Padding="12,8" Background="#363654" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已安装程序" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCount, StringFormat=' — 已选 {0} 个'}" 
                                           Foreground="#A78BFA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding SelectedSizeDisplay, StringFormat=' ({0})'}" 
                                           Foreground="#A78BFA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="选建议迁移" Padding="6,3" FontSize="10" Margin="0,0,3,0"
                                        Command="{Binding SelectRecommendedCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                            <Setter Property="Background" Value="#166534"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="选需分析" Padding="6,3" FontSize="10" Margin="0,0,3,0"
                                        Command="{Binding SelectCautionCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                            <Setter Property="Background" Value="#78350F"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="选不建议" Padding="6,3" FontSize="10" Margin="0,0,3,0"
                                        Command="{Binding SelectNotRecommendedCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="全选" Style="{StaticResource SecondaryBtn}" 
                                        Command="{Binding SelectAllCommand}" Padding="6,3" FontSize="10" Margin="0,0,3,0"/>
                                <Button Content="清除" Style="{StaticResource SecondaryBtn}" 
                                        Command="{Binding DeselectAllCommand}" Padding="6,3" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Program DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Programs}" 
                              SelectedItem="{Binding SelectedProgram}"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="#2D2D44" AlternatingRowBackground="#333352"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              FontFamily="Microsoft YaHei UI" FontSize="12"
                              RowHeight="36" ColumnHeaderHeight="32"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#4B5563"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4C1D95"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4C1D95"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3B3B5C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="36" Header=""/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="程序名" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="大小" Width="72" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="建议" Width="78" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecommendDisplay}" 
                                                   Foreground="{Binding Recommendation, Converter={StaticResource RecColorConv}}"
                                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="风险" Width="62" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskDisplay}" 
                                                   Foreground="{Binding Risk, Converter={StaticResource RiskColorConv}}"
                                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="78" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusColorConv}}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Detail Panel -->
            <Border Grid.Column="1" Background="#2D2D44" CornerRadius="8" Margin="6,0,0,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- No selection placeholder -->
                    <TextBlock Grid.RowSpan="3" Text="选择一个程序查看详情" 
                               Foreground="#6B7280" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVis}, 
                                           ConverterParameter=Invert, FallbackValue=Visible}"/>

                    <!-- Detail content (visible when program selected) -->
                    <StackPanel Grid.Row="0" Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SelectedProgram.Name}" FontSize="16" FontWeight="Bold" 
                                   Foreground="#F3F4F6" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedProgram.Publisher}" Foreground="#9CA3AF" 
                                   FontSize="11" Margin="0,2,0,0"/>

                        <!-- Recommendation badge -->
                        <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#374151"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProgram.Recommendation}" Value="Recommended">
                                            <Setter Property="Background" Value="#14532D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedProgram.Recommendation}" Value="Caution">
                                            <Setter Property="Background" Value="#78350F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedProgram.Recommendation}" Value="NotRecommended">
                                            <Setter Property="Background" Value="#7F1D1D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedProgram.RecommendDisplay}"
                                       Foreground="{Binding SelectedProgram.Recommendation, Converter={StaticResource RecColorConv}}"
                                       FontWeight="Bold" FontSize="13"/>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="路径:" Foreground="#9CA3AF" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProgram.InstallLocation}" 
                                       TextWrapping="Wrap" FontSize="11" Margin="8,2,0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="版本:" Foreground="#9CA3AF" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProgram.Version}" 
                                       Margin="8,2,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="大小:" Foreground="#9CA3AF" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProgram.SizeDisplay}" 
                                       Foreground="#FDE047" FontWeight="SemiBold" Margin="8,2,0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="风险:" Foreground="#9CA3AF" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding SelectedProgram.RiskDisplay}"
                                       Foreground="{Binding SelectedProgram.Risk, Converter={StaticResource RiskColorConv}}"
                                       FontWeight="Bold" Margin="8,2,0,2"/>
                        </Grid>

                        <!-- Recommendation reason -->
                        <Border Margin="0,8,0,0" Padding="8,6" Background="#1E1E2E" CornerRadius="4">
                            <TextBlock Text="{Binding SelectedProgram.RecommendReason}" 
                                       Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>

                        <Button Content="分析此程序" Style="{StaticResource ActionBtn}"
                                Command="{Binding AnalyzeSelectedCommand}" 
                                HorizontalAlignment="Left" Margin="0,10,0,0" FontSize="12" Padding="12,6"/>
                    </StackPanel>

                    <!-- References header -->
                    <TextBlock Grid.Row="1" Text="引用列表" FontWeight="Bold" FontSize="13"
                               Foreground="#D1D5DB" Margin="0,14,0,6"
                               Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVis}}"/>

                    <!-- References list -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding SelectedProgram.References}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#E2E8F0" FontSize="11"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVis}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,1" Background="#363654" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource RefIconConv}}"
                                                   VerticalAlignment="Top" FontSize="13"/>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding OriginalValue}" Foreground="#9CA3AF" 
                                                       FontSize="10" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" Margin="12,8" Padding="16,12" Background="#2D2D44" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Target drive -->
                <TextBlock Grid.Column="0" Text="目标盘:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}" 
                          SelectedItem="{Binding SelectedDrive}" Width="70" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding TargetPath, StringFormat=目标: {0}}" 
                           Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <!-- Action buttons -->
                <Button Grid.Column="3" Content="扫描 C 盘" Style="{StaticResource ActionBtn}"
                        Command="{Binding ScanCommand}" Margin="8,0"
                        ToolTip="扫描并自动分析所有C盘已安装程序"/>
                <Button Grid.Column="4" Content="开始迁移" Style="{StaticResource ActionBtn}"
                        Command="{Binding MigrateCommand}" Margin="0,0,4,0"
                        Background="#059669" ToolTip="将选中程序迁移到目标盘"/>
                <Button Grid.Column="5" Content="彻底卸载" Style="{StaticResource DangerBtn}"
                        Command="{Binding UninstallCommand}" Margin="0,0,4,0"
                        ToolTip="强制删除选中程序：进程+文件+注册表+快捷方式"/>
                <Button Grid.Column="6" Content="取消" Style="{StaticResource DangerBtn}"
                        Command="{Binding CancelCommand}" 
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="7" Content="关于" Margin="8,0,0,0" Padding="12,8" FontSize="12"
                        Background="#374151" Foreground="#D1D5DB" BorderThickness="0" Cursor="Hand"
                        Click="AboutButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Log Panel -->
        <Border Grid.Row="3" Margin="12,0,12,8" Background="#1A1A2E" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="操作日志" FontWeight="Bold" FontSize="12" 
                           Foreground="#6B7280" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" x:Name="LogListBox"
                         ItemsSource="{Binding LogMessages}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#9CA3AF" FontSize="11" 
                         FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,1"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2D2D44"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar with marquee progress -->
        <Border Grid.Row="4" Padding="16,10" Background="#181825">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status text + completed count -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" 
                               Foreground="#D1D5DB" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{Binding Progress, StringFormat={}{0:F0}%}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Marquee progress bar (跑马灯) -->
                <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             BorderThickness="0" Background="#1E1E2E">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#C084FC" Offset="0.5"/>
                            <GradientStop Color="#A78BFA" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</Window>
